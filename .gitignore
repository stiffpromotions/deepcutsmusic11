# Drupal 11 project with Composer-managed dependencies at the repository root.

# Ignore macOS metadata and local frontend dependencies.
.DS_Store
node_modules/

# Ignore ddev config files
/.ddev

# Ignore graphics files
/_resources

# Ignore configuration files that may contain sensitive information
/sites/*/*settings*.php
/sites/*/*services*.yml

# Ignore libraries
# /libraries
/libraries/fitvids/
/libraries/rtseo.js/

# Ignore paths that may contain user-generated content
/sites/*/files
/sites/*/public
/sites/*/private
/sites/*/files-public
/sites/*/files-private
/private-files/

# Ignore paths that may contain temporary files
/sites/*/translations
/sites/*/tmp
/sites/*/cache
/tmp

# Ignore testing related files
/sites/simpletest

# Ignore drupal core (if not versioning drupal sources)
/core
/modules/*
/themes/README.txt
/themes/contrib/*
/profiles/README.txt
/profiles/contrib/
/sites/README.txt
/sites/example.sites.php
/sites/example.settings.local.php
/sites/development.services.yml
/vendor
/.csslintrc
/.editorconfig
/.eslintignore
/.eslintrc.json
/.gitattributes
/.htaccess
/autoload.php
# Keep composer.json and composer.lock tracked for reproducible deployments.
/example.gitignore
/index.php
/LICENSE.txt
/README.txt
/robots.txt
/update.php
/web.config
/.ht.router.php
/INSTALL.txt

# Track deployment configuration, exported Drupal configuration, and shared
# local/live settings. Keep compiled custom theme CSS tracked as well.
!/.cpanel.yml
!/sync/*
!/sites/default/settings.local.php
/autoload_runtime.php
# Track project-specific modules.
!/modules/custom/
!/modules/custom/**
