{# Footer links remain editable through Drupal's Footer menu. #}
{% if items %}
  <ul{{ attributes.addClass('site-footer__menu') }}>
    {% for item in items %}
      <li{{ item.attributes.addClass(item.is_footer_action ? 'site-footer__action', item.is_footer_social ? 'site-footer__social') }}>
        {% if item.is_footer_social %}
          <a href="{{ item.url }}" aria-label="{{ 'Deep Cuts on Instagram'|t }}">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" focusable="false">
              <rect x="3" y="3" width="18" height="18" rx="5"/>
              <circle cx="12" cy="12" r="4"/>
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>
            </svg>
          </a>
        {% else %}
          {{ link(item.title, item.url, {'class': item.is_footer_cta ? ['btn', 'btn-nav'] : ['site-footer__link']}) }}
        {% endif %}
      </li>
    {% endfor %}
  </ul>
{% endif %}
